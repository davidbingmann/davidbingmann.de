davidbingmann.de {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        -Server
    }

    @private path /private /private/*
    respond @private 404

    @feedback path /api/semestral/feedback /api/semestral/feedback/
    reverse_proxy @feedback semestral_feedback:5002

    # Only the beacon is public; the numbers are under /api/admin/insights.
    @insights path /api/insights/hit
    reverse_proxy @insights mywebsite_insights:5003

    # Login for the admin panel (Authelia: password, then a passkey or a
    # one-time code). It must stay outside the guarded paths below.
    @authelia path /auth /auth/*
    reverse_proxy @authelia mywebsite_auth:9091

    # Admin panel: the page and its API only answer after a full two-factor
    # login. The admin services are reachable only from inside this block, so
    # nothing gets to them without passing Authelia first; the page itself
    # falls through to the app below once the login has passed.
    @admin path /admin /admin/* /api/admin /api/admin/*
    route @admin {
        forward_auth mywebsite_auth:9091 {
            uri /api/authz/forward-auth
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        reverse_proxy /api/admin/insights mywebsite_insights:5003
        reverse_proxy /api/admin/* mywebsite_admin:5004
    }

    # Semestral product pages: their own container.
    @semestral path /semestral /semestral/*
    reverse_proxy @semestral semestral_site:8080

    # MCP server for Notion agents; it checks the token itself.
    @studipmcp path /studip-mcp
    reverse_proxy @studipmcp studip_mcp:8000

    reverse_proxy mywebsite_app:5001
}
